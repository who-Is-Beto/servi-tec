# ============================================================
# TecServi - Variables de entorno para analítica y SEO
# Copia este archivo a `.env` y llena los IDs reales cuando existan.
# Si una variable deja vacío, el bloque de tracking NO se carga.
# ============================================================

# Google Tag Manager
VITE_GOOGLE_TAG_MANAGER_ID=

# GA4 (Measurement ID)
VITE_GA4_MEASUREMENT_ID=

# Google Ads: Conversion ID para el evento de llamada / lead
VITE_GOOGLE_ADS_CONVERSION_ID=

# Meta Pixel (solo el número, sin "Px")
VITE_META_PIXEL_ID=

# URL base del sitio (canonical, JSON-LD y sitemap)
VITE_SITE_URL=https://tecservi.mx

# WhatsApp: número en formato internacional (solo dígitos) para el botón flotante
VITE_WHATSAPP_NUMBER=52556908945